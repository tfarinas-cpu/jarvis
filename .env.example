# Jira Cloud API (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://seguroslafise.atlassian.net
JIRA_EMAIL=tfarinas@lafise.com
JIRA_API_TOKEN=

# Proyecto de mesa de servicios
JIRA_PROJECT=SLGMS

# Primera sync: días hacia atrás si no hay estado previo (default 365)
JIRA_SYNC_INITIAL_DAYS=365

# Sync al arrancar (start.bat o node server.js). Requiere JIRA_EMAIL + JIRA_API_TOKEN.
JIRA_SYNC_ON_START=1

# Sync periódica en background (0 o vacío = solo al arrancar, sin intervalo)
# JIRA_SYNC_INTERVAL_MINUTES=60

# JIRA_SYNC_STATUS_MODE=category   # Done category (Cerrado + Finalizado/Done). Use "list" for status in (...)
# JIRA_SYNC_MIN_LOOKBACK_MS=86400000
# JIRA_SYNC_OVERLAP_MS=3600000

# Filtro por Sistema (campo Jira customfield Sistema). Vacío = sincronizar todos.
# Coincide raíz exacta: SISNET, SISNET/EMISIONES, OPTICO / Documentos, etc.
# Al activarlo, el sync purga del disco notas locales fuera del filtro (solo SLGMS-*.md).
# JIRA_SYNC_SISTEMA_FILTER=SISNET,OPTICO

# ID del custom field Sistema en otra instancia Jira (default customfield_10319)
# JIRA_FIELD_SISTEMA=customfield_10319

# Fuente de datos al arrancar: Jira API gana sobre CSV automático.
# CSV solo al inicio si pones JARVIS_IMPORT_CSV_ON_START=1 (no recomendado con API).
# JARVIS_IMPORT_CSV_ON_START=0
# JARVIS_SYNC_FULL_ON_START=1

# Notas Dendron (opcional)
# DENDRON_NOTES_DIR=./notes
# PORT=8000
